 176   3                  tmp &= ~0xE0;
 177   3              }
 178   2      
 179   2              tens_place = tmp >> 4;
 180   2              one_place = tmp & (~0xF0);
 181   2              tmp = tens_place * 10 + one_place;
 182   2          }
 183   1      
 184   1          return tmp;
 185   1      }

 338          /**
 339           * @brief 向aip1302写入数据
 340           *          1. 内部会进行格式转换,以适配寄存器的格式
 341           *          会根据命令,屏蔽传入的数据的一些数据位
 342           *          2. 函数内部在写入前会解开芯片的写保护，写入完成后会打开芯片的写�
             -��护
 343           *
 344           * @param cmd 命令，待写入的寄存器的地址
 345           * @param byte 要写入的1字节数据，函数内部会对数据做好相应的处理，以符合对应
             -的寄存器的格式
 346           *
 347           * @return  void
 348           */
 349          void aip1302_write_byte(const u8 cmd, u8 byte)
 350          {
 351   1          u8 tmp = byte;
 352   1          // 根据命令cmd，将对应的数据做好转换(转换成寄存器中存放的格式)，再写入
 353   1      
 354   1          if (cmd == AIP1302_SEC_REG_ADDR || cmd == AIP1302_MIN_REG_ADDR || cmd == AIP1302_HOUR_REG_ADDR || cmd 
             -== AIP1302_DATE_REG_ADDR || cmd == AIP1302_MONTH_REG_ADDR || cmd == AIP1302_YEAR_REG_ADDR) {
 355   2              u8 tens_place = 0; // 十位
 356   2              u8 one_place = 0;  // 个位
C51 COMPILER V9.60.7.0   AIP1302                                                           08/10/2026 16:55:35 PAGE 7   

 357   2              if (tmp >= 10) {
 358   3                  tens_place = tmp / 10;
 359   3              }
 360   2              one_place = tmp % 10;
 361   2      
 362   2              // 秒、分钟、小时、日、月、年寄存器都是高4位数据存放以10为单位的数�
             -�，低4位存放以1为单位的数据
 363   2              tmp = tens_place << 4 | one_place;
 364   2              // 秒寄存器中，清除bit7,bit7==0,时钟IC的晶振会继续振荡
 365   2              // 在分钟寄存器的bit7未使用，默认就是0
 366   2              // 年寄存器的bit7存放有效数据，不清零
 367   2              if (AIP1302_SEC_REG_ADDR == cmd || AIP1302_MIN_REG_ADDR == cmd) {
 368   3                  tmp &= ~0x80;
 369   3              } else if (AIP1302_HOUR_REG_ADDR == cmd || AIP1302_DATE_REG_ADDR == cmd) {
 370   3                  // 小时寄存器，清除bit7和bit6，bit7清零，表示使用24h制，bit6未使用
 371   3                  // 日寄存器，bit7和bit6未使用
 372   3                  tmp &= ~0xC0;
 373   3              } else if (AIP1302_MONTH_REG_ADDR == cmd) {
 374   3                  // 月寄存器，bit7~5未使用
 375   3                  tmp &= ~0xE0;
 376   3              }
 377   2          }
 378   1      
 379   1          // 解除写保护
 380   1          __aip1302_write_byte__(AIP1302_WRITE_PROTECT_REG_ADDR, 0x00);
 381   1          __aip1302_write_byte__(cmd, tmp); // 写入数据
 382   1          // 开启写保护
 383   1          __aip1302_write_byte__(AIP1302_WRITE_PROTECT_REG_ADDR, 0x80);
 384   1      }

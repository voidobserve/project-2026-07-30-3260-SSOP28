 176   3              }
 177   2      
 178   2              tens_place = tmp >> 4;
 179   2              one_place = tmp & (~0xF0);
 180   2              tmp = tens_place * 10 + one_place;
 181   2          }
 182   1      
 183   1          return tmp;
 184   1      }

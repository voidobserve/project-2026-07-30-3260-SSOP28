 339          /**
 340           * @brief 向aip1302写入数据
 341           *          1. 内部会进行格式转换,以适配寄存器的格式
 342           *          会根据命令,屏蔽传入的数据的一些数据位
 343           *          2. 函数内部在写入前会解开芯片的写保护，写入完成后会打开芯片的写�
             -��护
 344           *
 345           * @param cmd 命令，待写入的寄存器的地址
 346           * @param byte 要写入的1字节数据，函数内部会对数据做好相应的处理，以符合对应
             -的寄存器的格式
 347           *
 348           * @return  void
 349           */
 350          void aip1302_write_byte(const u8 cmd, u8 byte)
 351          {
 352   1          u8 tmp = byte;
 353   1          // 根据命令cmd，将对应的数据做好转换(转换成寄存器中存放的格式)，再写入
 354   1      
 355   1          if (cmd == AIP1302_SEC_REG_ADDR || cmd == AIP1302_MIN_REG_ADDR || cmd == AIP1302_HOUR_REG_ADDR || cmd 
             -== AIP1302_DATE_REG_ADDR || cmd == AIP1302_MONTH_REG_ADDR || cmd == AIP1302_YEAR_REG_ADDR) {
 356   2              u8 tens_place = 0; // 十位
C51 COMPILER V9.60.7.0   AIP1302                                                           08/13/2026 15:38:11 PAGE 7   

 357   2              u8 one_place = 0;  // 个位
 358   2              if (tmp >= 10) {
 359   3                  tens_place = tmp / 10;
 360   3              }
 361   2              one_place = tmp % 10;
 362   2      
 363   2              // 秒、分钟、小时、日、月、年寄存器都是高4位数据存放以10为单位的数�
             -�，低4位存放以1为单位的数据
 364   2              tmp = tens_place << 4 | one_place;
 365   2              // 秒寄存器中，清除bit7,bit7==0,时钟IC的晶振会继续振荡
 366   2              // 在分钟寄存器的bit7未使用，默认就是0
 367   2              // 年寄存器的bit7存放有效数据，不清零
 368   2              if (AIP1302_SEC_REG_ADDR == cmd || AIP1302_MIN_REG_ADDR == cmd) {
 369   3                  tmp &= ~0x80;
 370   3              } else if (AIP1302_HOUR_REG_ADDR == cmd || AIP1302_DATE_REG_ADDR == cmd) {
 371   3                  // 小时寄存器，清除bit7和bit6，bit7清零，表示使用24h制，bit6未使用
 372   3                  // 日寄存器，bit7和bit6未使用
 373   3                  tmp &= ~0xC0;
 374   3              } else if (AIP1302_MONTH_REG_ADDR == cmd) {
 375   3                  // 月寄存器，bit7~5未使用
 376   3                  tmp &= ~0xE0;
 377   3              }
 378   2          }
 379   1      
 380   1          // 解除写保护
 381   1          __aip1302_write_byte__(AIP1302_WRITE_PROTECT_REG_ADDR, 0x00);
 382   1          __aip1302_write_byte__(cmd, tmp); // 写入数据
 383   1          // 开启写保护
 384   1          __aip1302_write_byte__(AIP1302_WRITE_PROTECT_REG_ADDR, 0x80);
 385   1      }

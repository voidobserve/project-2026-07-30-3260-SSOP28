 126          // 将8位变量中的数据反转(例：0b 0111 0101  -> 0b 1010 1110)
 127          static u8 reverse_bits_u8(u8 arg)
 128          {
 129   1          u8 tmp;   // 临时值，不需要赋值初始值，后续移位会覆盖掉这些未初始化的值
 130   1          u8 i = 0; // 循环计数值
 131   1      
 132   1          // 直接从aip1302读出的数据是LSB低位在前的，这里先做反转
 133   1          for (i = 0; i < 8; i++) {
 134   2              tmp <<= 1;
 135   2              if (arg & 0x01) {
 136   3                  tmp |= 0x01;
 137   3              }
 138   2      
 139   2              arg >>= 1;
 140   2          }
 141   1      
 142   1          return tmp;
 143   1      }
 144          
 145          // 对读出的数据做格式转换
 146          static u8 __aip1302_convert_read_byte__(const u8 cmd, const u8 byte)
 147          {
 148   1          u8 tmp = 0;
 149   1          u8 i = 0; // 循环计数值
 150   1      
 151   1          // 直接从aip1302读出的数据是LSB低位在前的，这里先做反转
 152   1          tmp = reverse_bits_u8(byte);
 153   1          // printf("val %bx \n", tmp); // 测试反转后的数据
 154   1      
 155   1          // 根据命令，判断是从哪个寄存器读出的数据，在根据手册对应的格式做转换
 156   1          if (cmd == (AIP1302_SEC_REG_ADDR + 1) ||   /* 秒寄存器 */
 157   1              cmd == (AIP1302_MIN_REG_ADDR + 1) ||   /* 分钟寄存器 */
 158   1              cmd == (AIP1302_HOUR_REG_ADDR + 1) ||  /* 小时寄存器 */
 159   1              cmd == (AIP1302_DATE_REG_ADDR + 1) ||  /* 日期寄存器 */
 160   1              cmd == (AIP1302_MONTH_REG_ADDR + 1) || /* 月份寄存器 */
 161   1              cmd == (AIP1302_YEAR_REG_ADDR + 1))    /* 年寄存器 */
 162   1          {
 163   2              u8 tens_place = 0; // 十位
 164   2              u8 one_place = 0;  // 个位
 165   2      
 166   2              if ((AIP1302_SEC_REG_ADDR + 1) == cmd || (AIP1302_MIN_REG_ADDR + 1) == cmd) {
 167   3                  // 秒寄存器、分寄存器中中，清除bit7,bit6~bit0才是有效数据
 168   3                  // 如果在时钟芯片上电复位后，没有开启晶振，这里会读取到 tmp==255
 169   3                  tmp &= ~0x80;
 170   3              } else if ((AIP1302_HOUR_REG_ADDR + 1) == cmd || (AIP1302_DATE_REG_ADDR + 1) == cmd) {
 171   3                  // 小时、日寄存器，清除bit7和bit6,未使用
 172   3                  tmp &= ~0xC0;
 173   3              } else if ((AIP1302_MONTH_REG_ADDR + 1) == cmd) {
 174   3                  // 月寄存器，bit7~5未使用
 175   3                  tmp &= ~0xE0;

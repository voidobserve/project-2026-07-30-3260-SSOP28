   1          // 定时器TMR2的驱动源文件
   2          #include "tmr2.h"
   3          #include "include.h"
   4          
   5          // 定时器定时周期 (单位:Hz)
   6          // 周期值 = 系统时钟 / 定时器分频 / 频率 - 1
   7          #define TMR2_PERIOD (SYSCLK / 1 / 20000 - 1) // 20khz，50us 
   8          /**
   9           * @brief 配置定时器TMR2，配置完成后，定时器默认关闭
  10           */
  11          void tmr2_config(void)
  12          {
  13   1          __SetIRQnIP(TMR2_IRQn, TMR2_IQn_CFG); // 设置中断优先级
  14   1          __DisableIRQ(TMR2_IRQn);              // 禁用中断
  15   1          IE_EA = 1;                            // 打开总中断
  16   1      
  17   1          // 清除TMR2的计数值
  18   1          TMR_ALLCON = TMR2_CNT_CLR(0x1); // 清除计数值
  19   1      
  20   1          // 配置TMR2的计数周期
  21   1          TMR2_PRH = TMR_PERIOD_VAL_H((TMR2_PERIOD >> 8) & 0xFF); // 周期值
  22   1          TMR2_PRL = TMR_PERIOD_VAL_L((TMR2_PERIOD >> 0) & 0xFF);
  23   1      
  24   1          TMR2_CONH &= ~TMR_PRD_PND(0x01); // 清除TMR2的计数标志位，表示未完成计数
  25   1          TMR2_CONH |= TMR_PRD_IRQ_EN(1);  // 使能TMR2的计数中断
  26   1      
  27   1          TMR2_CONL &= ~(TMR_SOURCE_SEL(0x07) |   // 清除定时器的时钟源配置寄存器
  28   1                         TMR_PRESCALE_SEL(0x07) | // 清除TMR2的预分频配置寄存器
  29   1                         TMR_MODE_SEL(0x03));     // 清除TMR2的模式配置寄存器
  30   1          TMR2_CONL |= TMR_SOURCE_SEL(0x06) |     // 配置定时器的时钟源，使用系统时钟
  31   1                       TMR_PRESCALE_SEL(0x00) |   // 定时器预分频
  32   1                       TMR_MODE_SEL(0x01);        // 配置TMR2的模式为计数器模式，最后对系统时�
             -��的脉冲进行计数
  33   1      
  34   1          __EnableIRQ(TMR2_IRQn); // 使能中断
  35   1      }
  36          
  37          // TMR2中断服务函数
  38          void TIMR2_IRQHandler(void) interrupt TMR2_IRQn
  39          {
  40   1          // 进入中断设置IP，不可删除
  41   1          __IRQnIPnPush(TMR2_IRQn);
  42   1      
  43   1          // ---------------- 用户函数处理 -------------------
  44   1          // 周期中断
  45   1          if (TMR2_CONH & TMR_PRD_PND(0x1))
  46   1          {
  47   2              TMR2_CONH |= TMR_PRD_PND(0x1); // 清除pending
  48   2      

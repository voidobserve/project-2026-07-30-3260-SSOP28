  92   2              // %lu\n", instrument.save_info.subtotal_mileage_2);
  93   2          }
  94   1      
  95   1          if (distance >= 1000) // 1000mm -- 1m
  96   1          {
  97   2              // 如果走过的距离超过了1m，再进行保存（保存到变量）
  98   2              // 99 9999 KM
  99   2              if (instrument.save_info.total_mileage < (u32)(999999 * 1000)) {
 100   3                  instrument.save_info.total_mileage++; // +1m
 101   3              }
 102   2      
 103   2              // 99999.9 KM
 104   2              if (instrument.save_info.subtotal_mileage < (u32)(999999 * 100)) {
 105   3                  instrument.save_info.subtotal_mileage++; // +1m
 106   3              }
 107   2      
 108   2              distance -= 1000; // 剩下的、未保存的、不满1m的数据留到下一次再保存
 109   2      
 110   2              {
 111   3                  static u8 cnt = 0;
 112   3                  cnt++;
 113   3                  // if (cnt >= 10) // cnt >= 10，说明走过了10m

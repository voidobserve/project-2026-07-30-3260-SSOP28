  86   2              // printf("sub_total_mileage %lu\n",
  87   2              // instrument.save_info.subtotal_mileage); printf("sub_total_mileage_2
  88   2              // %lu\n", instrument.save_info.subtotal_mileage_2);
  89   2          }
  90   1      
  91   1          if (distance >= 1000) // 1000mm -- 1m
  92   1          {
  93   2              // 如果走过的距离超过了1m，再进行保存（保存到变量）
  94   2              // 99 9999 KM
  95   2              if (instrument.save_info.total_mileage < (u32)(999999 * 1000)) {
  96   3                  instrument.save_info.total_mileage++; // +1m
  97   3              }
  98   2      
  99   2              // 99999.9 KM
 100   2              if (instrument.save_info.subtotal_mileage < (u32)(999999 * 100)) {
 101   3                  instrument.save_info.subtotal_mileage++; // +1m
 102   3              }
 103   2      
 104   2              distance -= 1000; // 剩下的、未保存的、不满1m的数据留到下一次再保存
 105   2      
 106   2              {
 107   3                  static u8 cnt = 0;
 108   3                  cnt++;
 109   3                  // if (cnt >= 10) // cnt >= 10，说明走过了10m

  72   1              1--有里程变化，需要保存
  73   1              目前每过1m就会置位一次，保存之后清零
  74   1          */
  75   1          static volatile bit flag_is_any_mileage_save;
  76   1      
  77   1          // 每过1s，且里程有变化，就保存一次；这个里程变化的条件最好大于10m，否�
             -��会经常写入eeprom
  78   1          if ((mileage_save_time_cnt >= (u16)5 * 1000) && /* xx ms后 */
  79   1              flag_is_any_mileage_save)                   /* 里程有变化，需要保存 */
  80   1          {
  81   2              instrument_info_save_enable();
  82   2              flag_is_any_mileage_save = 0;
  83   2              mileage_save_time_cnt = 0;
  84   2      
  85   2              // printf("mile save\n");
  86   2      
  87   2              // printf("total_mileage %lu\n", instrument.save_info.total_mileage);
  88   2              // printf("sub_total_mileage %lu\n",
  89   2              // instrument.save_info.subtotal_mileage); printf("sub_total_mileage_2
  90   2              // %lu\n", instrument.save_info.subtotal_mileage_2);
  91   2          }
  92   1      
  93   1          if (distance >= 1000) // 1000mm -- 1m
  94   1          {
  95   2              // 如果走过的距离超过了1m，再进行保存（保存到变量）
  96   2              // 99 9999 KM
  97   2              if (instrument.save_info.total_mileage < (u32)(999999 * 1000)) {
  98   3                  instrument.save_info.total_mileage++; // +1m
  99   3              }
 100   2      
 101   2              // 99999.9 KM
 102   2              if (instrument.save_info.subtotal_mileage < (u32)(999999 * 100)) {
 103   3                  instrument.save_info.subtotal_mileage++; // +1m
 104   3              }
 105   2      
 106   2              distance -= 1000; // 剩下的、未保存的、不满1m的数据留到下一次再保存
 107   2      
 108   2              {
 109   3                  static u8 cnt = 0;
 110   3                  cnt++;
 111   3                  // if (cnt >= 10) // cnt >= 10，说明走过了10m
 112   3                  if (cnt >= 100) {
 113   4                      cnt = 0;

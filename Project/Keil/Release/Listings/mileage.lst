  72   1          */
  73   1          static volatile bit flag_is_any_mileage_save;
  74   1      
  75   1          // 每过1s，且里程有变化，就保存一次；这个里程变化的条件最好大于10m，否�
             -��会经常写入eeprom
  76   1          if ((mileage_save_time_cnt >= (u16)5 * 1000) && /* xx ms后 */
  77   1              flag_is_any_mileage_save)                   /* 里程有变化，需要保存 */
  78   1          {

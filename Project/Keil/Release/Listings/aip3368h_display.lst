 241           *
 242           * @param gear 挡位 0 ~ 27
 243           *
 244           *      0：空挡，清空显示
 245           *      1：1挡，显示1格
 246           *
 247           */
 248          void aip3368h_display_engine_speed_gear(u8 gear)
 249          {
 250   1          // 清空原来的显示
 251   1          u8 i;
 252   1      
 253   1          for (i = 0; i < ARRAY_SIZE(engine_speed_gear_map); i++) {
 254   2              if (gear <= i) {
 255   3                  // 如果传参的挡位，比当前遍历的挡位还要小，清空对应的显示
 256   3                  aip3368h_engine_speed_panel_display_buff[engine_speed_gear_map[i].buff_index] &=
 257   3                      ~(0x01 << engine_speed_gear_map[i].bit_offset);
 258   3              } else if ((gear - i) > 0) {
 259   3                  // 如果传参的挡位，比当前遍历的挡位还要大（至少要大于等于1）
 260   3                  aip3368h_engine_speed_panel_display_buff[engine_speed_gear_map[i].buff_index] |=
 261   3                      (0x01 << engine_speed_gear_map[i].bit_offset);
 262   3              }
 263   2          }
 264   1      }

 181   1          P1_MD0 &= ~GPIO_P11_MODE_SEL(0x03);
 182   1          P1_MD0 |= GPIO_P11_MODE_SEL(0x01);
 183   1          FOUT_S11 = GPIO_FOUT_AF_FUNC;
 184   1          // DIO
 185   1          P0_MD0 &= ~GPIO_P03_MODE_SEL(0x03);
 186   1          P0_MD0 |= GPIO_P03_MODE_SEL(0x01);
 187   1          FOUT_S03 = GPIO_FOUT_AF_FUNC;
 188   1      
 189   1          P1_MD1 &= ~GPIO_P15_MODE_SEL(0x03);
 190   1          P1_MD1 |= GPIO_P15_MODE_SEL(0x01);
 191   1          FOUT_S15 = GPIO_FOUT_AF_FUNC;
 192   1          // LAT
 193   1          P1_MD0 &= ~GPIO_P12_MODE_SEL(0x03);

 213          /**
 214           * @brief 设置显示的亮度
 215           *
 216           * @param brightness 亮度值 0 ~ 100
 217           *          数值越大，亮度越高
 218           *
 219           */
 220          void aip3368h_module_set_brightness(u8 brightness)
 221          {
 222   1          // PDM脚是低电平使能，因此占空比越低，亮度越高
 223   1          u16 channel_duty = (u32)(100 - brightness) * STMR0_PEROID_VAL / 100;
 224   1      
 225   1          STMR0_CMPAH = STMR_CMPA_VAL_H(((channel_duty) >> 8) & 0xFF); // 比较值
 226   1          STMR0_CMPAL = STMR_CMPA_VAL_L(((channel_duty) >> 0) & 0xFF); // 比较值
 227   1          STMR_LOADEN |= STMR_0_LOAD_EN(0x1);                          // 自动装载使能
 228   1      }

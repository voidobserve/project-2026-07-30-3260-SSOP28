 184   1          FOUT_S16 = GPIO_FOUT_STMR0_PWMOUT; // 选择stmr0_pwmout
 185   1      
 186   1      #define STMR0_PEROID_VAL (SYSCLK / 1 / 1000 - 1) // 周期值=系统时钟/分频/频率 - 1
 187   1          // STIMER0配置1kHz PWM
 188   1          STMR0_PSC = STMR_PRESCALE_VAL(0x00);                        // 不分频
 189   1          STMR0_PRH = STMR_PRD_VAL_H((STMR0_PEROID_VAL >> 8) & 0xFF); // 周期高八位寄存器
 190   1          STMR0_PRL = STMR_PRD_VAL_L((STMR0_PEROID_VAL >> 0) & 0xFF); // 周期低八位寄存器
 191   1          STMR0_CMPAH = STMR_CMPA_VAL_H(((0) >> 8) & 0xFF);           // 比较值
 192   1          STMR0_CMPAL = STMR_CMPA_VAL_L(((0) >> 0) & 0xFF);           // 比较值
 193   1      
 194   1          STMR_PWMVALA = STMR_0_PWMVALA(0x00); // PWM输出值
 195   1          STMR_PWMEN |= STMR_0_PWM_EN(0x1);    // PWM输出使能
 196   1          STMR_CNTMD |= STMR_0_CNT_MODE(0x1);  // 选择连续计数模式
 197   1          STMR_LOADEN |= STMR_0_LOAD_EN(0x1);  // 自动装载使能
 198   1          STMR_CNTCLR |= STMR_0_CNT_CLR(0x1);  // 计数清零
 199   1          STMR_CNTEN |= STMR_0_CNT_EN(0x1);    // 计数使能

 164   1          // DCK
 165   1          P1_MD0 &= ~GPIO_P11_MODE_SEL(0x03);
 166   1          P1_MD0 |= GPIO_P11_MODE_SEL(0x01);
 167   1          FOUT_S11 = GPIO_FOUT_AF_FUNC;
 168   1          // DIO

  57          static void aip3368h_module_send_data_to_all_dev(const u16 *buff_group_1,
  58                                                           const u8 len_group_1,
  59                                                           const u16 *buff_group_2,
  60                                                           const u8 len_group_2)
  61          {
  62   1          volatile u8 i;
  63   1          volatile u8 j;
  64   1          volatile u16 dat_group_1;
  65   1          volatile u16 dat_group_2;
  66   1      
  67   1          /*
  68   1              两组级联（时速面板 6 颗、发动机转速面板 8 颗）共用 DCK 和 LAT，
  69   1              因此一帧的时钟数必须等于最大的级联数（AIP3368_MAX_IC_NUM = 8 个字）。
  70   1      
  71   1              移位寄存器型级联：先发的数据会填充到最远端的芯片，
  72   1              发多了的字会从级联链末端移出而丢失（不是“截取前一段再转发”）。
  73   1              所以级联数较少的一组，数据必须从帧的“末尾”开始发送：
  74   1              字偏移 offset = AIP3368_MAX_IC_NUM - 本组级联数。
  75   1              时速面板 offset = 8 - 6 = 2，其 6 个字占帧的第 2~7 个位置，
  76   1              恰好落在 6 颗芯片上，前面 2 个字补 0（被移出丢失，无影响）。
  77   1              发动机转速面板 offset = 0，8 个字正好占满整帧。
  78   1          */
  79   1          volatile u8 offset_group_1 = AIP3368_MAX_IC_NUM - len_group_1;
  80   1          volatile u8 offset_group_2 = AIP3368_MAX_IC_NUM - len_group_2;
  81   1      
  82   1          // 开始
  83   1          DCK = 0;
  84   1          LAT = 0;
  85   1          aip3368h_delay();
  86   1      
  87   1          // 一帧完整数据
  88   1          for (i = 0; i < AIP3368_MAX_IC_NUM; i++) {
  89   2              // 本组数据在帧中的位置：i < offset 的部分补 0（会被移出级联链）
  90   2              dat_group_1 = 0;
  91   2              dat_group_2 = 0;
  92   2      
  93   2              if (i >= offset_group_1) {
  94   3                  dat_group_1 = buff_group_1[i - offset_group_1];
  95   3              }
  96   2      
  97   2              if (i >= offset_group_2) {
  98   3                  dat_group_2 = buff_group_2[i - offset_group_2];
  99   3              }
 100   2      
 101   2              for (j = 0; j < 16; j++) {
 102   3                  DIO_GROUP_1 = dat_group_1 & (u16)0x8000 ? 1 : 0;
 103   3                  DIO_GROUP_2 = dat_group_2 & (u16)0x8000 ? 1 : 0;
 104   3      
 105   3                  aip3368h_delay();
 106   3                  DCK = 1;
 107   3                  aip3368h_delay();
 108   3      
 109   3                  dat_group_1 <<= 1;
 110   3                  dat_group_2 <<= 1;
 111   3      
 112   3                  DCK = 0;
 113   3                  aip3368h_delay();
 114   3              }
 115   2          }
C51 COMPILER V9.60.7.0   AIP3368                                                           08/14/2026 11:02:16 PAGE 3   

 116   1      
 117   1          // 结束
 118   1          LAT = 1;
 119   1          aip3368h_delay();
 120   1          LAT = 0;
 121   1          aip3368h_delay();
 122   1          DIO_GROUP_1 = 0;
 123   1          DIO_GROUP_2 = 0;
 124   1      }

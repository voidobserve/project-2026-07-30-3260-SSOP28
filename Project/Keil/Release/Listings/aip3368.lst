 230          /**
 231           * @brief 设置显示的亮度
 232           *
 233           * @param brightness 亮度值 0 ~ 100
 234           *          数值越大，亮度越高
 235           *
 236           */
C51 COMPILER V9.60.7.0   AIP3368                                                           08/13/2026 11:19:06 PAGE 5   

 237          void aip3368h_module_set_brightness(u8 brightness)
 238          {
 239   1          // PDM脚是低电平使能，因此占空比越低，亮度越高
 240   1          u16 channel_duty = (u32)(100 - brightness) * STMR0_PEROID_VAL / 100;
 241   1      
 242   1          STMR0_CMPAH = STMR_CMPA_VAL_H(((channel_duty) >> 8) & 0xFF); // 比较值
 243   1          STMR0_CMPAL = STMR_CMPA_VAL_L(((channel_duty) >> 0) & 0xFF); // 比较值
 244   1          STMR_LOADEN |= STMR_0_LOAD_EN(0x1);                          // 自动装载使能
 245   1      }

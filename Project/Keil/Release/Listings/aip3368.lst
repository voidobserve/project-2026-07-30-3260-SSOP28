 233          /**
 234           * @brief 设置显示的亮度
 235           *
 236           * @param brightness 亮度值 0 ~ 100
 237           *          数值越大，亮度越高
 238           *
C51 COMPILER V9.60.7.0   AIP3368                                                           08/14/2026 11:02:16 PAGE 5   

 239           */
 240          void aip3368h_module_set_brightness(u8 brightness)
 241          {
 242   1          // PDM脚是低电平使能，因此占空比越低，亮度越高
 243   1          u16 channel_duty = (u32)(100 - brightness) * STMR0_PEROID_VAL / 100;
 244   1      
 245   1          STMR0_CMPAH = STMR_CMPA_VAL_H(((channel_duty) >> 8) & 0xFF); // 比较值
 246   1          STMR0_CMPAL = STMR_CMPA_VAL_L(((channel_duty) >> 0) & 0xFF); // 比较值
 247   1          STMR_LOADEN |= STMR_0_LOAD_EN(0x1);                          // 自动装载使能
 248   1      }

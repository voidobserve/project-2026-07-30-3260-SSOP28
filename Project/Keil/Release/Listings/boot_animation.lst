 363          void boot_animation_process(void)
 364          {
 365   1          memset(&boot_animation_param, 0x00, sizeof(boot_animation_param_t));
 366   1          boot_animation_param.is_in_boot_animation = 1;
 367   1      
 368   1          while (boot_animation_param.is_in_boot_animation) {
 369   2              WDT_KEY = WDT_KEY_VAL(0xAA); // 喂狗并清除 wdt_pending
 370   2      
 371   2              if (boot_animation_param.time_base_cnt < 1) {
 372   3                  // 时间未到来
 373   3                  continue;
 374   3              } else {
 375   3                  boot_animation_param.time_base_cnt = 0;
 376   3              }
 377   2      
 378   2              __boot_animation_phase_0__();
 379   2              __boot_animation_phase_1__();
 380   2      
 381   2              if (BOOT_ANIMATION_PHASE_END == boot_animation_param.animation_phase) {
 382   3                  // 开机动画结束，根据存储的参数，立即更新显示
 383   3                  // 可以交给后续的功能来更新显示，不用在这里立即显示
 384   3                  boot_animation_param.is_in_boot_animation = 0;
 385   3              }
 386   2      
 387   2              aip3368h_module_display(); // 更新显示
 388   2          }
 389   1      }



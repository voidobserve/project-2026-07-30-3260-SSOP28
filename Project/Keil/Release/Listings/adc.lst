  19   1                      (0x01 << 0);  // adc0中断使能
  20   1          ADC_CFG2 = 0xFF;          // 通道0采样时间配置为256个采样时钟周期
  21   1      
  22   1          ADC_ACON0 = ADC_CMP_EN(0x1) |  // 打开ADC中的CMP使能信号

  17   1      
  18   1      #if (!USER_DEBUG_ENABLE)
                  // 2 档 检测脚：
                  P2_PU |= GPIO_P21_PULL_UP(0x01);      // 上拉
                  P2_MD0 &= ~(GPIO_P21_MODE_SEL(0x03)); // 输入模式
              #endif
  23   1      
  24   1          // 3 档 检测脚：
  25   1          P1_PU |= GPIO_P13_PULL_UP(0x01);      // 上拉
  26   1          P1_MD0 &= ~(GPIO_P13_MODE_SEL(0x03)); // 输入模式
  27   1      
  28   1          // 4 档 检测脚：
  29   1          P2_PU |= GPIO_P20_PULL_UP(0x01);      // 上拉
  30   1          P2_MD0 &= ~(GPIO_P20_MODE_SEL(0x03)); // 输入模式
  31   1      
  32   1          // 5 档 检测脚：
  33   1          P3_PU |= GPIO_P31_PULL_UP(0x01);      // 上拉
  34   1          P3_MD0 &= ~(GPIO_P31_MODE_SEL(0x03)); // 输入模式
  35   1      
  36   1          // 6 档 检测脚：
  37   1          P1_PU |= GPIO_P17_PULL_UP(0x01);      // 上拉
  38   1          P1_MD1 &= ~(GPIO_P17_MODE_SEL(0x03)); // 输入模式
  39   1      
  40   1          // 检测 发动机故障 的引脚:
  41   1          P2_PU |= GPIO_P22_PULL_UP(0x01);      // 上拉

  54          // 引脚电平扫描
  55          void pin_level_scan(void)
  56          {
  57   1          // 扫描挡位时，以检测到的最低挡位为优先
  58   1          if (SIGNAL_VALID_LEV_OF_GEAR_N == PIN_DETECT_GEAR_N) {
  59   2              instrument.gear = GEAR_NEUTRAL;
  60   2          } else if (SIGNAL_VALID_LEV_OF_GEAR_1 == PIN_DETECT_GEAR_1) {
  61   2              instrument.gear = GEAR_FIRST;
  62   2          } else if (SIGNAL_VALID_LEV_OF_GEAR_2 == PIN_DETECT_GEAR_2) {
  63   2              instrument.gear = GEAR_SECOND;
  64   2          } else if (SIGNAL_VALID_LEV_OF_GEAR_3 == PIN_DETECT_GEAR_3) {
  65   2              instrument.gear = GEAR_THIRD;
  66   2          } else if (SIGNAL_VALID_LEV_OF_GEAR_4 == PIN_DETECT_GEAR_4) {
  67   2              instrument.gear = GEAR_FOURTH;
  68   2          } else if (SIGNAL_VALID_LEV_OF_GEAR_5 == PIN_DETECT_GEAR_5) {
  69   2              instrument.gear = GEAR_FIFTH;
  70   2          } else if (SIGNAL_VALID_LEV_OF_GEAR_6 == PIN_DETECT_GEAR_6) {
  71   2              instrument.gear = GEAR_SIXTH;
  72   2          } else {
  73   2              // 如果 N档 、 1档 ~ 6档 都没有检测到，说明挡位没有接线
  74   2              instrument.gear = GEAR_UNKNOWN;
  75   2          }
  76   1      
  77   1          // 显示挡位
  78   1          aip3368h_display_gear(instrument.gear);
  79   1      
  80   1          // 转向灯
  81   1          if (SIGNAL_VALID_LEV_OF_LEFT_TURN == PIN_DETECT_LEFT_TURN) {
  82   2              aip3368h_display_left_turn_light(1);
  83   2          } else {
  84   2              aip3368h_display_left_turn_light(0);
  85   2          }
  86   1      
  87   1          if (SIGNAL_VALID_LEV_OF_RIGHT_TURN == PIN_DETECT_RIGHT_TURN) {
  88   2              aip3368h_display_right_turn_light(1);
  89   2          } else {
  90   2              aip3368h_display_right_turn_light(0);
  91   2          }
  92   1      
  93   1          // 远光灯（大灯）
  94   1          if (SIGNAL_VALID_LEV_OF_HIGH_BEAM == PIN_DETECT_HIGH_BEAM) {
  95   2              aip3368h_display_high_beam_light(1);
  96   2          } else {
  97   2              aip3368h_display_high_beam_light(0);
  98   2          }
  99   1      
 100   1          if (SIGNAL_VALID_LEV_OF_BREAKDOWN == PIN_DETECT_BREAKDOWN) {
 101   2              aip3368h_display_engine_fault_light(1);
 102   2          } else {
 103   2              aip3368h_display_engine_fault_light(0);
 104   2          }
 105   1      }
